# 基础路径
APP_DATA_PATH=D:/soft/novel-splitter
DOCKER_DATA_PATH=./data
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=novel_splitter
# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=password

# ChromaDB
CHROMA_URL=http://localhost:8000
CHROMA_PORT=8000

# Backend
NOVEL_LLM_PROVIDER=deepseek
BACKEND_PORT=8080
STORAGE_ROOT_PATH=data/novel-storage
LOG_PATH=logs
JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC

# ONNX 重排模型 (bge-reranker-base)
ASSEMBLER_ENABLE_RERANKER=false
# 外部模型路径（可选），为空时从 classpath 加载
ASSEMBLER_RERANKER_MODEL_PATH=
# API 统一鉴权 Token（对应后端 api.auth.token）
# 生产环境请使用高强度随机字符串，并定期轮换
API_AUTH_TOKEN=change_me_to_a_strong_token

# Frontend
FRONTEND_PORT=80
VITE_API_PROXY_TARGET=http://localhost:8080
# 前端 API 请求超时（毫秒）
VITE_API_TIMEOUT=300000
# 是否开启前端 API 请求/响应调试日志（true/false）
VITE_ENABLE_API_LOG=false

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Coze
COZE_BASE_URL=https://api.coze.com
COZE_API_KEY=
COZE_BOT_ID=
COZE_USER_ID=user_default
