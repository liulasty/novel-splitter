# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=novel_splitter

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password

# ChromaDB
CHROMA_URL=http://chromadb:8000
CHROMA_PORT=8000

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=80

# Volumes path (Windows path or Linux path)
DOCKER_DATA_PATH=D:\docker_data
APP_DATA_PATH=D:\soft\novel-splitter

