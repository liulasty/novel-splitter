# 基础路径
APP_DATA_PATH=D:/soft/novel-splitter
DOCKER_DATA_PATH=./data
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=novel_splitter
ADMINER_PORT=8081

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=password

# ChromaDB
CHROMA_URL=http://localhost:8000
CHROMA_PORT=8000

# Backend
NOVEL_LLM_PROVIDER=deepseek
BACKEND_PORT=8080
STORAGE_ROOT_PATH=data/novel-storage
LOG_PATH=logs
JAVA_OPTS=-Xmx1g -Xms512m

# Frontend
FRONTEND_PORT=80
VITE_API_PROXY_TARGET=http://localhost:8080

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Coze
COZE_BASE_URL=https://api.coze.com
COZE_API_KEY=
COZE_BOT_ID=
COZE_USER_ID=user_default
